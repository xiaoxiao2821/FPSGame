# 典型UE5忽略规则
/Binaries/
/Intermediate/
/Saved/
*.tmp
*.log

# Visual Studio 缓存（含被 VS 实时锁定的 .vsidx 索引文件，必须忽略）
.vs/

# 其他常见 UE 生成目录（体积大、可重建）
DerivedDataCache/

# Visual Studio / Rider 工程文件（由 GenerateProjectFiles 重建，通常不入库）
*.sln
*.slnx
.idea/

# 打包/编译诊断残留（临时调试文件，不入库）
/build_tdm*
/package_log*.txt
/package_exit*.txt
/link_*.txt
/link_diag*.txt
/compile_diag*.txt
/lib_diag*.txt
/probe_types*.txt
/wire_tdm*.txt
/killcheck*.txt
/cleanup_check.txt
/inspect_tdm_ui.txt
/ds_build_*.log
/ds_run_test*.log
/ds_ds_test.log
/listen_test.log
/build_login_fix.log
/build_fpsserver.log

# 临时诊断脚本（一次性工具，不入库）
/*.py
/run_package*.sh
